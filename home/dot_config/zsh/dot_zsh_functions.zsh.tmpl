# vim: syntax=sh

function brew_bundle() {
  echo "Run brew bundle..."
  brew bundle --no-lock --file={{ .brew.brewfilePath }}
}

function brew_update {
  brew update &&
  brew upgrade --greedy &&
  brew cleanup
}

function brew_trust_taps {
  brew tap | grep -v '^homebrew/' | xargs -n1 brew trust
}

function zinit_update {
  zi self-update &&
  zi update --all &&
  zi delete --clean
}

function nvim_plugins_update {
  echo "Updating Neovim plugins..."
  nvim --headless "+Lazy! sync" +qa
  echo "Updated Neovim plugins!"
  
  echo "Updating Mason tools..."
  nvim --headless -c 'lua require("lazy").load({plugins = {"mason.nvim","mason-tool-installer.nvim"}}); vim.cmd("MasonUpdate"); vim.cmd("MasonToolsUpdateSync"); vim.cmd("qa")'
  echo "Updated Mason tools!"

  echo "Updating Treesitter parsers..."
  nvim --headless -c 'lua require("nvim-treesitter").update(nil, {summary=true}):wait(); vim.cmd("qa")'
  printf "\nUpdated Treesitter parsers!\n"
}

function nvim_lspconfig_drift {
  {{ joinPath .chezmoi.homeDir ".config" "nvim" "scripts" "check-lspconfig-drift" }} "$@"
}

function uv_update {
  uv tool upgrade --all &&
  uv clean
}

function update_all {
  brew_update &&
  zinit_update &&
  nvim_plugins_update &&
  uv_update &&
  gh extension upgrade --all &&
  mise reshim &&
  tv update-channels &&
  rm -f ${XDG_CACHE_HOME:-$HOME/.cache}/tv-aliases.txt
}

function miszo_git_local_config {
  git config --local user.name {{ .name | quote }}
  git config --local user.email {{ .git.personal.email | quote }}
  echo "Local git user email changed to personal"
  git config --local --get user.name
  git config --local --get user.email
}

function git_clear_gone_branches {
  git remote prune origin
  git branch -vv | grep ': gone]'|  grep -v "\*" | awk '{ print $1; }' | xargs -I{} -n 1 git branch -D {}
  git prune
}

function copy_branch {
  git rev-parse --abbrev-ref HEAD | pbcopy
  echo Copied branch name: \`$(pbpaste)\`
}

function remove_docker_containers {
  echo "Stop running docker containers"
  docker stop $(docker ps -q)
  echo "Remove docker containers"
  docker rm $(docker ps -a -q)
}

function remove_docker_images {
  remove_docker_containers
  echo "Remove docker images"
  docker rmi $(docker images -f "dangling=true" -q)
}

function clean_docker {
  remove_docker_images
  echo "Remove docker volumes"
  docker volume rm $(docker volume ls -qf dangling=true)
  echo "Docker cleanup done!"
}


function git_pull_them_all {
  for D in *; do
      if [ -d "${D}/.git" ]; then
          echo "Running git pull and clean branches in ${D}" && cd "${D}" && git pull && git_clear_gone_branches && cd .. && echo "Done!\n"
      fi
  done
}

function add_git_hook() {
  # Check if both arguments are provided
  if [[ $# -ne 2 ]]; then
      echo "Usage: add_git_hook <source_path> <hook_name>"
      return 1
  fi

  local source_path="$1"
  local hook_name="$2"

  # Robust Git repository check
  if ! git rev-parse --is-inside-work-tree > /dev/null 2>&1; then
      echo "Error: Not in a Git repository"
      return 1
  fi

  # Get the root directory of the Git repository
  local git_root=$(git rev-parse --show-toplevel)
  local git_hooks_dir="$git_root/.git/hooks"

  # Ensure the hooks directory exists
  mkdir -p "$git_hooks_dir"

  # Full path for the destination hook
  local destination_hook="$git_hooks_dir/$hook_name"

  # Check if source path exists and is a file
  if [[ ! -f "$source_path" ]]; then
      echo "Error: Source path '$source_path' does not exist or is not a file"
      return 1
  fi

  # Copy the hook file
  cp "$source_path" "$destination_hook"
  chmod +x "$destination_hook"
  echo "Git hook '$hook_name' added successfully from $source_path"
}

function add_git_hook_conventional_commit_msg() {
  add_git_hook {{ joinPath .chezmoi.homeDir ".config" "git" "hooks" "conventional-commit-msg" | quote }} "commit-msg"
}

function add_git_hook_js_pre_commit() {
  add_git_hook {{ joinPath .chezmoi.homeDir ".config" "git" "hooks" "js-pre-commit" | quote }} "pre-commit"
}

function add_git_hooks() {
  add_git_hook_conventional_commit_msg
  add_git_hook_js_pre_commit
}

function export_app_settings {
  echo "Exporting settings for $1..."
  defaults export $2 $3
  echo "Settings exported for $1!"
}

function import_app_settings {
  echo "Importing settings for $1..."
  defaults import $2 $3
  echo "Settings imported for $1!"
}

function export_all_settings {
  export_app_settings "Better Display" "pro.betterdisplay.BetterDisplay" {{ .exportedSettings.betterDisplayFilePath }}
  export_app_settings "Velja" "com.sindresorhus.Velja" {{ .exportedSettings.veljaFilePath }}
}

function import_all_settings {
  import_app_settings "Better Display" "pro.betterdisplay.BetterDisplay" {{ .exportedSettings.betterDisplayFilePath }}
  import_app_settings "Velja" "com.sindresorhus.Velja" {{ .exportedSettings.veljaFilePath }}
}

function delete_recursively {
  readonly folder_name=${1:?"node_modules"}
  find . -name "$folder_name" -type d -prune -print -exec rm -rf '{}' \;
}


function fix_colima {
  local memory="${1:-4}"
  echo "Removing Colima from home directory..."
  rm -rf {{ joinPath .chezmoi.homeDir ".colima" }}
  echo "Starting Colima with ${memory}GB of memory..."
  colima start --memory="${memory}"
}

function _wt_root {
  git rev-parse --is-inside-work-tree >/dev/null 2>&1 || {
    print -u2 "Run this from inside a Git checkout."
    return 1
  }

  git worktree list --porcelain |
    awk '/^worktree / { print substr($0, 10); exit }'
}

function _wt_task() (
  local mode="$1"
  local task="${2:-}"
  local background="${3:-}"
  local root config

  command -v workmux >/dev/null 2>&1 || {
    print -u2 "Install WorkMux: brew install raine/workmux/workmux"
    return 1
  }

  root=$(_wt_root) || return 1
  cd "$root" || return 1

  if [[ -z "$task" ]]; then
    read "task?Task branch name: " || return 1
    [[ -n "$task" ]] || return 0
  fi

  git check-ref-format --branch "$task" >/dev/null 2>&1 || {
    print -u2 "Invalid task branch name: $task"
    return 1
  }

  if workmux path "$task" >/dev/null 2>&1; then
    if [[ "$background" == background ]]; then
      print -u2 -r -- "[workmux] Task already exists: $task"
      return 0
    fi
    print -u2 -r -- "[workmux] Opening task: $task"
    workmux open "$task"
    return $?
  fi

  local -a options
  options=()

  if [[ "$mode" == dependencies ]]; then
    config="$root/.workmux.dependencies.yaml"

    [[ -f "$config" ]] || {
      print -u2 "Dependency profile missing: $config"
      return 1
    }

    options=(--config "$config")
  fi

  [[ "$background" == background ]] && options+=(--background --session)

  print -u2 -r -- "[workmux] Fetching remote updates for: $root"
  git fetch --progress --verbose || {
    local result=$?
    print -u2 "[workmux] Fetch failed; task creation stopped."
    return "$result"
  }

  print -u2 -r -- "[workmux] Creating task: $task ($mode profile)"
  print -u2 "[workmux] Setting up worktree files and opening the task session..."
  workmux add "$task" --open-if-exists "${options[@]}" || {
    local result=$?
    print -u2 -r -- "[workmux] Task setup failed: $task"
    return "$result"
  }
)

function _wt_worker {
  local mode="$1" task="$2" client="$3" result setup_session

  [[ -n "$task" ]] || return 0
  tmux set-option -w -t "$TMUX_PANE" remain-on-exit on
  setup_session=$(tmux display-message -p -t "$TMUX_PANE" '#{session_name}')
  print -r -- "[workmux] Background setup: $task ($mode profile)"
  _wt_task "$mode" "$task" background
  result=$?

  if (( result == 0 )); then
    print -r -- "[workmux] Ready: $task. Open it with wt or the session picker."
    tmux display-message -c "$client" -d 7000 "WorkMux task ready: $task"
    tmux set-option -w -t "$TMUX_PANE" remain-on-exit off
  else
    print -u2 -r -- "[workmux] Setup failed (exit $result). Logs remain in this window."
    tmux display-message -c "$client" -d 7000 "WorkMux setup failed: $task — see $setup_session"
    local -a error_popup
    error_popup=(tmux display-popup -E -c "$client" -x C -y C -w 80% -h 70%
      -T "WorkMux setup failed: $task (q to close)"
      zsh -f -c 'tmux capture-pane -p -J -S - -t "$1" | less -R' -- "$TMUX_PANE")
    tmux run-shell -b "${(j: :)${(@qqq)error_popup}}"
  fi

  return "$result"
}

function _wt_input {
  local mode="$1" task=""

  bindkey -e
  bindkey '^[' send-break
  print
  while true; do
    vared -p '  Branch: ' task || return 0
    [[ -n "$task" ]] || return 0
    if git check-ref-format --branch "$task" >/dev/null 2>&1; then
      _wt_start "$mode" "$task"
      return $?
    fi
    print -u2 -r -- "  Invalid branch name: $task"
  done
}

function _wt_prompt {
  local mode="$1" root="$2" client="$3" functions_file="$4"

  tmux display-popup -C -c "$client"
  tmux display-popup -E -c "$client" -d "$root" \
    -x C -y C -w 60 -h 7 -T "New WorkMux task ($mode)" \
    zsh -fi -c 'source "$1"; _wt_input "$2"' -- "$functions_file" "$mode"
}

function _wt_start() (
  local mode="$1" task="${2:-}" root client functions_file setup_session
  local worker='source "$1"; _wt_worker "$2" "$3" "$4"'

  [[ -n "$TMUX" ]] || {
    print -u2 "Run wt/wtd inside tmux to create tasks in the background."
    return 1
  }
  command -v workmux >/dev/null 2>&1 || {
    print -u2 "Install WorkMux: brew install raine/workmux/workmux"
    return 1
  }

  root=$(_wt_root) || return 1
  cd "$root" || return 1
  client=$(tmux display-message -p -t "$TMUX_PANE" '#{client_name}') || return 1
  functions_file="${ZDOTDIR:-$HOME/.config/zsh}/.zsh_functions.zsh"

  if [[ -z "$task" ]]; then
    local -a prompt_args
    prompt_args=(zsh -f -c 'source "$1"; _wt_prompt "$2" "$3" "$4" "$5"'
      -- "$functions_file" "$mode" "$root" "$client" "$functions_file")
    tmux run-shell -b "${(j: :)${(@qqq)prompt_args}}"
    return $?
  fi

  git check-ref-format --branch "$task" >/dev/null 2>&1 || {
    print -u2 -r -- "Invalid task branch name: $task"
    return 1
  }
  if workmux path "$task" >/dev/null 2>&1; then
    workmux open "$task"
    return $?
  fi

  setup_session="workmux-setup-${root:t}-${(L)task}-$RANDOM"
  setup_session=${setup_session//[^[:alnum:]_-]/-}
  tmux new-session -d -s "$setup_session" -n setup -c "$root" \
    zsh -f -c "$worker" -- "$functions_file" "$mode" "$task" "$client" || return $?
  tmux display-message -c "$client" "WorkMux setup started: $task — logs in $setup_session"
)

function wt() (
  if (( $# > 1 )); then
    print -u2 "Usage: wt [task-branch]"
    return 1
  fi

  if (( $# == 0 )); then
    local root
    root=$(_wt_root) || return 1
    cd "$root" || return 1
    tv workmux
  else
    _wt_start regular "$1"
  fi
)

function _wt_cleanup() (
  local task="${1:-}" root worktree_path client label functions_file cleanup_session
  local -a cleanup_args
  local cleanup='source "$1"; _wt_cleanup_worker "$2" "$3" "$4"'

  [[ -z "$task" || "$task" == "+ Create task" ]] && return 0
  [[ -n "$TMUX" ]] || return 1
  git check-ref-format --branch "$task" >/dev/null 2>&1 || return 1
  root=$(_wt_root) || return 1
  cd "$root" || return 1
  worktree_path=$(workmux path "$task") || return 1
  [[ "$worktree_path" != "$root" ]] || {
    print -u2 "The main checkout cannot be removed."
    return 1
  }
  client=$(tmux display-message -p -t "$TMUX_PANE" '#{client_name}') || return 1
  functions_file="${ZDOTDIR:-$HOME/.config/zsh}/.zsh_functions.zsh"
  label="Remove $task worktree, session and local branch? (y/n)"
  cleanup_session="workmux-cleanup-${root:t}-${(L)task}-$RANDOM"
  cleanup_session=${cleanup_session//[^[:alnum:]_-]/-}
  cleanup_args=(new-session -d -s "$cleanup_session" -n cleanup -c "$root"
    zsh -f -c "$cleanup" -- "$functions_file" "$root" "$task" "$client")
  print -r -- "confirm-before -b -t ${(qqq)client} -p ${(qqq)label} { ${(j: :)${(@qqq)cleanup_args}} }" |
    tmux source-file -
)

function _wt_cleanup_worker() (
  local root="$1" task="$2" client="$3" result cleanup_session

  cd "$root" || return 1
  tmux set-option -w -t "$TMUX_PANE" remain-on-exit on
  cleanup_session=$(tmux display-message -p -t "$TMUX_PANE" '#{session_name}')
  print -r -- "[workmux] Cleaning up: $task"
  tmux display-message -c "$client" "WorkMux cleanup started: $task — details in $cleanup_session"
  workmux remove "$task"
  result=$?

  if (( result == 0 )); then
    tmux display-message -c "$client" -d 7000 "WorkMux task cleaned up: $task"
    tmux set-option -w -t "$TMUX_PANE" remain-on-exit off
  else
    print -u2 -r -- "[workmux] Cleanup cancelled or failed (exit $result). Logs remain here."
    tmux display-message -c "$client" -d 7000 "WorkMux cleanup stopped: $task — see $cleanup_session"
  fi
  return "$result"
)

function wtd {
  if (( $# > 1 )); then
    print -u2 "Usage: wtd [task-branch]"
    return 1
  fi

  _wt_start dependencies "${1:-}"
}
