# vim: syntax=toml
# Mise configuration
# https://mise.jdx.dev/configuration.html

[tools]
chezmoi = "latest"
rust = "1.96.0"
ruby = { version = "3.4.1", postinstall = "gem install bundler better_errors rake railties ruby-lsp ruby-lsp-rails ruby-lsp-rspec rubocop rubocop-packaging rubocop-performance rubocop-rails rubocop-rspec rubocop-rubycw rubocop-shopify rubocop-thread_safety test-prof amazing_print hirb" }
node = "26.13.0"
pnpm = "latest"
yarn = "1"
python = "3.13.11"
awscli = "2.13.18"
bun = "1.3.9"
java = "temurin-21.0.11+10.0.LTS"
go = "1.26.3"
lua = "5.1"
deno = "2.8.1"
just = "1.51.0"
zig = "0.16.0"
{{ if not .computer.isWork -}}
php = "8.5.3"
{{- end }}

[settings]
# Enable legacy version file support (.tool-versions, .node-version, etc.)
legacy_version_file = true

# Verbose output
verbose = false
